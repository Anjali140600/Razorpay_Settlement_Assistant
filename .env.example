# LLM Q&A (optional — preset buttons stay rule-based without API keys)
USE_LLM=0

# Groq (primary — free tier, OpenAI-compatible)
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Cerebras (fallback when Groq fails)
CEREBRAS_API_KEY=csk_your_key_here
CEREBRAS_MODEL=gpt-oss-120b

# OpenAI (alternative)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

AGENT_MAX_STEPS=4
