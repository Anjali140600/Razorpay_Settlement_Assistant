# LLM Q&A (optional — preset buttons stay rule-based without API keys)
USE_LLM=0

# Groq (primary — free tier, OpenAI-compatible)
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (fallback when Groq fails — OpenAI-compatible endpoint)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (fallback when Groq and Gemini fail)
OPENROUTER_API_KEY=sk-or-your_key_here
OPENROUTER_MODEL=openai/gpt-oss-120b

AGENT_MAX_STEPS=4
